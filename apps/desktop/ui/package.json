{
  "name": "miyazato-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "branding:sync": "node scripts/sync-branding.mjs",
    "predev": "npm run branding:sync",
    "prebuild": "npm run branding:sync"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "i18next": "^26.4.3",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.7.2",
    "vite": "^7.3.1",
    "vitest": "4.1.11",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "prettier": "^3.6.2",
    "@types/node": "^22.0.0",
    "@testing-library/dom": "^10.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
